# --- Application ---
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me

# --- PostgreSQL (TimescaleDB-enabled) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ucar
POSTGRES_USER=ucar
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- S3 / Garage object store ---
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=garage-dev-key
S3_SECRET_KEY=change-me
S3_USE_PATH_STYLE=true

# Garage cluster secrets — generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-32-byte-hex
GARAGE_ADMIN_TOKEN=change-me
GARAGE_METRICS_TOKEN=change-me

# --- Elasticsearch ---
ES_URL=http://elasticsearch:9200

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ucar
KEYCLOAK_CLIENT_ID=ucar-backend
KEYCLOAK_CLIENT_SECRET=change-me

# --- LLM / Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Observability ---
SENTRY_DSN=
PROMETHEUS_ENABLED=true
