# --- Application ---
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me

# --- PostgreSQL (TimescaleDB-enabled) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ucar
POSTGRES_USER=ucar
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- S3 / Garage object store ---
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=garage-dev-key
S3_SECRET_KEY=change-me
S3_USE_PATH_STYLE=true

# Garage cluster secrets — generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-32-byte-hex
GARAGE_ADMIN_TOKEN=change-me
GARAGE_METRICS_TOKEN=change-me

# --- Elasticsearch ---
ES_URL=http://elasticsearch:9200

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ucar
KEYCLOAK_CLIENT_ID=ucar-backend
KEYCLOAK_CLIENT_SECRET=change-me

# --- LLM / Anthropic ---
ANTHROPIC_API_KEY=
# Model used for column mapping (prototype only — see kpi_schema.py comment)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Gemini (column mapping prototype) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=20
MAPPING_CACHE_TTL_SECONDS=86400

# --- Ingestion service ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_PDF_PAGES=30
OCR_CONFIDENCE_HIGH=0.90
OCR_CONFIDENCE_LOW=0.60
CLAUDE_TIMEOUT_SECONDS=15
CLAUDE_MAX_RETRIES=2
ROLLBACK_WINDOW_DAYS=7
FILE_RETENTION_DAYS=365
EVENTS_CHANNEL=data.events

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Observability ---
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# --- Alembic (for migrations) ---
# Set this when running alembic outside docker: postgresql+psycopg://ucar:change-me@localhost:5432/ucar
ALEMBIC_DB_URL=
