# --- Application ---
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me

# --- PostgreSQL (TimescaleDB-enabled) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ucar
POSTGRES_USER=ucar
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false

# --- Elasticsearch ---
ES_URL=http://elasticsearch:9200

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ucar
KEYCLOAK_CLIENT_ID=ucar-backend
KEYCLOAK_CLIENT_SECRET=change-me

# --- LLM / Anthropic ---
ANTHROPIC_API_KEY=
# Model used for column mapping (prototype only — see kpi_schema.py comment)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Ingestion service ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_PDF_PAGES=30
OCR_CONFIDENCE_HIGH=0.90
OCR_CONFIDENCE_LOW=0.60
CLAUDE_TIMEOUT_SECONDS=15
CLAUDE_MAX_RETRIES=2
ROLLBACK_WINDOW_DAYS=7
FILE_RETENTION_DAYS=365
EVENTS_CHANNEL=data.events

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Observability ---
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# --- Alembic (for migrations) ---
# Set this when running alembic outside docker: postgresql+psycopg://ucar:change-me@localhost:5432/ucar
ALEMBIC_DB_URL=
